# Solo se carga con NODE_ENV=test (lo pone `node ace test`), y sus valores
# ganan a los de .env: lo que no esté aquí se hereda de allí.
SESSION_DRIVER=memory

# Database — servicio `db-test` de compose.yaml (pruebas, en memoria)
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
